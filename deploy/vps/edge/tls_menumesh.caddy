# For the server's admin: MenuMesh's snippet for /srv/edge/config/snippets.caddy, next to
# tls_jainav, installed with `sudo app-apply edge config snippets.caddy`. Every block of
# menumesh.caddy imports it. The certificate covers menumesh.in and *.menumesh.in and goes in with
# `sudo app-apply edge cert menumesh <origin.pem> <origin-key.pem> [<aop-ca.pem>]`.

# Cloudflare's Origin CA certificate for menumesh.in, made from a CSR on the server.
(tls_menumesh) {
	tls /certs/menumesh/origin.pem /certs/menumesh/origin-key.pem {
		# The admin turns this on before any MenuMesh container runs, with zone-level
		# Authenticated Origin Pulls on at Cloudflare.
		# client_auth {
		# 	mode require_and_verify
		# 	trust_pool file /certs/menumesh/aop-ca.pem
		# }
	}
}
