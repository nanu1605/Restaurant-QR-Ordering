# MenuMesh's lines for the server's /srv/edge/edge.env (root, 0600): the values menumesh.caddy
# reads as {$MENUMESH_*}. The server's admin adds them, only after /etc/apps/menumesh.conf exists
# (app-apply accepts a name only under a configured app's prefix), installs the file with
# `sudo app-apply edge env edge.env` and recreates Caddy (`sudo app-compose edge up -d`), which
# reads edge.env only when it is created. Values never in git: the password and its hash live in
# the owner's password manager.

# Staging's basic auth: one account. The owner makes the hash with the edge's own Caddy image on
# their own machine, never on the server, where the password would stay in the shell's history and
# show in the process list. Without --plaintext, Caddy reads it from the terminal, not echoed:
#   docker run --rm -it caddy:2.11.9-alpine caddy hash-password
# The admin gets only the hash. Keep the single quotes: the hash holds $ signs.
MENUMESH_STAGING_AUTH_USER=menumesh
MENUMESH_STAGING_AUTH_HASH='$2a$14$replace-me'
