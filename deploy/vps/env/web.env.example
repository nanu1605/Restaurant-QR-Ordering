# /srv/menumesh/env/web.env on the shared server (root, 0600): production's own settings, which
# the web container reads (env_file). Names from src/lib/env.server.ts; values from the owner's
# accounts and password manager, never in git (where each comes from: docs/RUNBOOK.md,
# "Environment variables (Vercel)").
#
# Not here: compose.yml sets SUPABASE_SECRET_KEY and CRON_SECRET from .env, and
# SUPABASE_INTERNAL_URL, SUPABASE_FORWARD_CLIENT_IP and NODE_OPTIONS itself, and its values win.
# NEXT_PUBLIC_* values are built into the image by CI. The test-only addresses
# (RAZORPAY_API_BASE_URL, RESEND_API_URL, TURNSTILE_VERIFY_URL, SENTRY_API_URL) stay unset, so the
# real services are used. An empty line means the app's default.

# Staff logins without an email are <username>@<slug>.staff.<domain>: menumesh.in
STAFF_EMAIL_DOMAIN=
# Signs the diners' device cookie: 32 or more random bytes (openssl rand -base64 48), not
# staging's.
CUSTOMER_COOKIE_SECRET=

# Razorpay's live keys and the signing secret of its webhook to /api/webhooks/razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend: the API key, the sender on menumesh.in ("MenuMesh <no-reply@menumesh.in>") and the
# signing secret of its webhook to /api/webhooks/resend.
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=

# The menu photo reader and its fallback; without either key photo import is hidden.
MENU_IMPORT_API_KEY=
MENU_IMPORT_FALLBACK_API_KEY=
# Optional: other readers, models or a rupee rate than the defaults.
MENU_IMPORT_BASE_URL=
MENU_IMPORT_MODEL=
MENU_IMPORT_FALLBACK_BASE_URL=
MENU_IMPORT_FALLBACK_MODEL=
MENU_IMPORT_USD_INR=

# Cloudflare Turnstile on the website's forms (the site for menumesh.in).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sentry's issue list on /super/system: a read-only token (event:read), the organisation and the
# project.
SENTRY_READ_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional: whose /api/health /super/system shows (default menumesh.in and staging.menumesh.in),
# and the trial and grace days (default 14 and 7).
PRODUCTION_APP_URL=
STAGING_APP_URL=
PLATFORM_TRIAL_DAYS=
PLATFORM_GRACE_DAYS=
