# /srv/menumesh/images.env on the shared server (root, 0644): the image each of this repository's
# services runs, read by Compose after .env. Copy this file there once, as it is; from then on only
# app-deploy writes it, one line per deploy, as <repository>:<tag>@sha256:<digest>. app-deploy
# replaces a line and never adds one, so every name needs its line from the start. ":none" means
# never deployed: a first deploy that fails stops its service instead of rolling back.
#
# Tags (immutable, never latest): staging-<40 hex>, prod-v<x.y.z>, migrate-<40 hex> and
# backup-<40 hex>. The supabase services are pinned in compose.yml instead.
WEB_IMAGE=ghcr.io/nanu1605/menumesh:none
STAGING_IMAGE=ghcr.io/nanu1605/menumesh:none
MIGRATE_IMAGE=ghcr.io/nanu1605/menumesh:none
MIGRATE_STAGING_IMAGE=ghcr.io/nanu1605/menumesh:none
BACKUP_IMAGE=ghcr.io/nanu1605/menumesh:none
