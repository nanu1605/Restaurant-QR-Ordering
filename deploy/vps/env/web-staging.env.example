# /srv/menumesh/env/web-staging.env on the shared server (root, 0600): staging's own settings,
# which the web-staging container reads (env_file). Staging runs on the server, but its database
# stays on its hosted Supabase project, so it talks to that project over the internet and never to
# production's stack. Names from src/lib/env.server.ts; values never in git.
#
# Not here: compose.yml sets CRON_SECRET (STAGING_CRON_SECRET in .env) and NODE_OPTIONS. Staging
# needs no SUPABASE_INTERNAL_URL (the hosted project's public address is built into its image) and
# no SUPABASE_FORWARD_CLIENT_IP (hosted Auth ignores it). NEXT_PUBLIC_* values are built into the
# image by CI. An empty line means the app's default.

# The hosted staging project's secret key (sb_secret_...), not production's.
SUPABASE_SECRET_KEY=
# staging.menumesh.in
STAFF_EMAIL_DOMAIN=
# Its own 32 or more random bytes, not production's.
CUSTOMER_COOKIE_SECRET=

# Razorpay's test keys (rzp_test_...) and the test webhook's signing secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional on staging: Resend, the menu reader, Turnstile and Sentry's issue list.
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
MENU_IMPORT_API_KEY=
MENU_IMPORT_FALLBACK_API_KEY=
MENU_IMPORT_BASE_URL=
MENU_IMPORT_MODEL=
MENU_IMPORT_FALLBACK_BASE_URL=
MENU_IMPORT_FALLBACK_MODEL=
MENU_IMPORT_USD_INR=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SENTRY_READ_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional: as in web.env.
PRODUCTION_APP_URL=
STAGING_APP_URL=
PLATFORM_TRIAL_DAYS=
PLATFORM_GRACE_DAYS=
