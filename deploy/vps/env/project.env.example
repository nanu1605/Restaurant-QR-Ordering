# /srv/menumesh/.env on the shared server (root, 0600): the values deploy/vps/compose.yml reads,
# and nothing else. app-compose passes it to every Compose call, then images.env. Names only: the
# real values live in this file on the server and in the owner's password manager, never in git.
#
# `pnpm vps:secrets` (scripts/vps-secrets.mts) writes every generated value below, in the formats
# of self-hosted Supabase's own key script. Hex and base64url only, so a value is safe in a URL, in
# Envoy's sed and in Compose's env-file parser. Put JSON values in single quotes. No line may start
# with COMPOSE_ (app-apply and app-deploy refuse the file), and app settings go in env/*.env.

# ─── Database ────────────────────────────────────────────────────────────────
# supabase_admin's and postgres's password, and the service roles' (authenticator,
# supabase_auth_admin, supabase_storage_admin, ...). Read by the image once, when the volume is
# created. 16 random bytes, hex: openssl rand -hex 16
POSTGRES_PASSWORD=

# ─── Auth keys ───────────────────────────────────────────────────────────────
# The legacy HS256 secret (Auth, Realtime, Storage) and the oct key of both JWKS below. 48 random
# bytes, base64url (64 characters).
JWT_SECRET=
# Auth's signing keys, as a JSON array: the EC P-256 private key (ES256, a UUID kid, used for user
# tokens) and the oct key above. In single quotes.
JWT_KEYS=
# {"keys":[the EC public key, the oct key]} for PostgREST, Realtime and Storage. Secret too: it
# holds JWT_SECRET. In single quotes.
JWT_JWKS=
# The legacy API keys: HS256 JWTs for the roles anon and service_role, issuer supabase, valid five
# years (the RUNBOOK records the date and how to rotate them).
ANON_KEY=
SERVICE_ROLE_KEY=
# The same two roles as ES256 JWTs with the kid of JWT_KEYS, five years: Envoy swaps the sb_ keys
# below for these.
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
# The opaque keys the app uses: sb_publishable_ / sb_secret_, 22 base64url characters, _ and an
# 8-character checksum. The publishable one is also the production image's
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (a GitHub variable); the secret one also goes to web.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ─── Realtime ────────────────────────────────────────────────────────────────
# 48 random bytes, base64url (at least 64 characters).
SECRET_KEY_BASE=
# Exactly 16 characters: openssl rand -hex 8
REALTIME_DB_ENC_KEY=

# ─── Public addresses (not secret) ───────────────────────────────────────────
# The app's address, Auth's site URL and TOTP issuer: https://menumesh.in
SITE_URL=
# The gateway's public address, through Cloudflare: https://api.menumesh.in
SUPABASE_PUBLIC_URL=

# ─── Scheduler ───────────────────────────────────────────────────────────────
# The bearer of /api/cron/*, production's and staging's each its own (32 random bytes,
# base64url). Compose gives them to web and scheduler, and to web-staging and scheduler-staging.
CRON_SECRET=
STAGING_CRON_SECRET=
# A monitor's heartbeat URLs, pinged after an HTTP 200 from each route; empty pings nothing. The
# daily and digest monitors expect a ping a day, the jobs monitor one a minute.
HEARTBEAT_DAILY_URL=
HEARTBEAT_DIGEST_URL=
HEARTBEAT_JOBS_URL=
STAGING_HEARTBEAT_DAILY_URL=
STAGING_HEARTBEAT_DIGEST_URL=
STAGING_HEARTBEAT_JOBS_URL=

# ─── Backups ─────────────────────────────────────────────────────────────────
# The owner's age public key (age1...) from age-keygen; the private half stays offline. It must
# equal BACKUP_RECIPIENT in /etc/apps/menumesh.conf: hostwatch alerts while they differ.
BACKUP_AGE_RECIPIENT=
# The India-region bucket and its S3-compatible provider, as rclone names it (AWS, Cloudflare,
# Wasabi, Other, ...), with an API token for that bucket only. The region may stay empty when the
# provider needs none.
BACKUP_BUCKET=
BACKUP_S3_PROVIDER=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Pinged after every full backup; the monitor alerts when 26 hours pass without one. Empty pings
# nothing.
HEARTBEAT_BACKUP_URL=
# The owner's alert bot and chat, told when a backup fails; empty sends nothing.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# The night a restore test or a recovery reads, its id as the backup's journal line prints it;
# empty takes the newest. Leave it empty here: for an older night, name its id on that one run
# instead, with `run --rm -e RESTORE_STAMP=<id> ...`, so it can't linger for the next monthly test.
RESTORE_STAMP=

# ─── Staging migrations ──────────────────────────────────────────────────────
# Hosted staging's session pooler (its Connect dialog, Session pooler): the host
# (aws-0-ap-south-1.pooler.supabase.com), the user (postgres.<project ref>) and the database
# password. migrate-staging checks the server against config/migrate/supabase-ca.crt.
STAGING_DB_HOST=
STAGING_DB_USER=
STAGING_DB_PASSWORD=
