# Copy to .env.local and fill in. Never commit real values.
# For local development, run `pnpm supabase status -o env` after `pnpm db:start`
# and copy API_URL, PUBLISHABLE_KEY and SECRET_KEY into the Supabase variables below.
#
# "Phase N" marks when a variable becomes required. Anything not required yet can stay empty.

# ─── App ────────────────────────────────────────────────────────────────────
# Base URL encoded in table QR codes (no trailing slash). Required.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase ───────────────────────────────────────────────────────────────
# Project URL. Required.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_…): browser/server client for signed-in staff. Required.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…): server only. Customer functions, platform admin actions,
# staff account creation. Bypasses RLS — never expose to the browser. Required.
SUPABASE_SECRET_KEY=

# ─── Staff logins ───────────────────────────────────────────────────────────
# Staff without an email get a non-deliverable login <username>@<slug>.staff.<domain>.
# Defaults to tableorder.test locally; set to the app's domain in staging/production.
# Changing it later is safe: logins resolve the stored email by restaurant code + username.
STAFF_EMAIL_DOMAIN=tableorder.test

# ─── Customer device cookie (Phase 3) ───────────────────────────────────────
# Signs the `cid` cookie. 32+ random bytes, e.g. `openssl rand -base64 48`.
CUSTOMER_COOKIE_SECRET=

# ─── Razorpay — platform subscriptions only (Phase 8) ───────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signature verification secret (set when registering the webhook URL).
RAZORPAY_WEBHOOK_SECRET=

# ─── Cron (Phase 8) ─────────────────────────────────────────────────────────
# Bearer token required by /api/cron/*.
CRON_SECRET=

# ─── Menu photo import (Phase 7) ────────────────────────────────────────────
# Feature is disabled cleanly when unset.
ANTHROPIC_API_KEY=
# Model id for menu extraction. Defaults to claude-sonnet-5 when empty.
MENU_IMPORT_MODEL=

# ─── Email via Resend (Phase 8) ─────────────────────────────────────────────
RESEND_API_KEY=
# Sender address on a verified domain, e.g. "DineFlow <no-reply@example.com>".
EMAIL_FROM=

# ─── Monitoring & analytics (Phase 10) ──────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ─── Platform defaults ──────────────────────────────────────────────────────
# Trial length and payment grace period in days (defaults 14 and 7).
PLATFORM_TRIAL_DAYS=14
PLATFORM_GRACE_DAYS=7
