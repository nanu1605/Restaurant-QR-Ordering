# Copy to .env.local and fill in. Never commit real values.
# For local development, run `pnpm supabase status -o env` after `pnpm db:start`
# and copy API_URL, PUBLISHABLE_KEY and SECRET_KEY into the Supabase variables below.
#
# "Phase N" marks when a variable becomes required. Anything not required yet can stay empty.

# ─── App ────────────────────────────────────────────────────────────────────
# Base URL encoded in table QR codes (no trailing slash). Required.
# Production: https://menumesh.in
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase ───────────────────────────────────────────────────────────────
# Project URL. Required.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_…): browser/server client for signed-in staff. Required.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…): server only. Customer functions, platform admin actions,
# staff account creation. Bypasses RLS — never expose to the browser. Required.
SUPABASE_SECRET_KEY=

# ─── Staff logins ───────────────────────────────────────────────────────────
# Staff without an email get a non-deliverable login <username>@<slug>.staff.<domain>.
# Defaults to tableorder.test locally; staging and production use menumesh.in.
# Changing it later is safe: logins resolve the stored email by restaurant code + username.
STAFF_EMAIL_DOMAIN=tableorder.test

# ─── Customer device cookie (Phase 3) ───────────────────────────────────────
# Signs the `cid` cookie. 32+ random bytes, e.g. `openssl rand -base64 48`.
CUSTOMER_COOKIE_SECRET=

# ─── Razorpay — platform subscriptions only (Phase 8) ───────────────────────
# Test-mode keys (rzp_test_…) from the Razorpay dashboard. Owners can pay
# online only when both are set; otherwise the Subscription page says to
# contact support.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signature verification secret (set when registering the webhook URL).
RAZORPAY_WEBHOOK_SECRET=
# Defaults to https://api.razorpay.com/v1 when empty (tests use a local mock).
RAZORPAY_API_BASE_URL=

# ─── Cron (Phase 8) ─────────────────────────────────────────────────────────
# Bearer token required by /api/cron/*.
CRON_SECRET=

# ─── Menu photo import (Phase 7) ────────────────────────────────────────────
# Any OpenAI-compatible /chat/completions API that reads images. Photo import
# is hidden when neither key is set (CSV import still works).
# Primary: Command Code Provider API (key from Command Code Studio).
MENU_IMPORT_API_KEY=
# Defaults to https://api.commandcode.ai/provider/v1 when empty.
MENU_IMPORT_BASE_URL=
# Defaults to google/gemini-3.8-flash when empty.
MENU_IMPORT_MODEL=
# Fallback, used for a page when the primary fails: OpenRouter by default.
MENU_IMPORT_FALLBACK_API_KEY=
# Defaults to https://openrouter.ai/api/v1 when empty.
MENU_IMPORT_FALLBACK_BASE_URL=
# Defaults to google/gemini-3.8-flash when empty.
MENU_IMPORT_FALLBACK_MODEL=
# Rupees per US dollar for the import cost shown in super-admin. Defaults to 96.
MENU_IMPORT_USD_INR=

# ─── Email via Resend (Phase 8) ─────────────────────────────────────────────
RESEND_API_KEY=
# Sender address on a verified domain, e.g. "MenuMesh <no-reply@menumesh.in>".
EMAIL_FROM=
# Resend's API address. Leave empty for https://api.resend.com (tests use a mock).
RESEND_API_URL=

# ─── Website forms: Cloudflare Turnstile (website W2) ──────────────────────
# Both keys from the Turnstile site for menumesh.in. Without them the "Book a
# demo" form is hidden (next dev uses Cloudflare's always-pass test keys).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Siteverify's address. Leave empty for Cloudflare's (tests use a mock).
TURNSTILE_VERIFY_URL=

# ─── Monitoring & analytics (Phase 10) ──────────────────────────────────────
# Sentry DSN (public by design), for the browser and the server. Empty = off.
NEXT_PUBLIC_SENTRY_DSN=
# "staging" or "production" (Sentry groups errors by it). Empty = development.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Build only: uploads source maps so Sentry shows the real code. The token is a
# GitHub secret (the deploy builds in GitHub Actions); org and project are in Vercel.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# PostHog project key and region host (https://us.i.posthog.com or https://eu.i.posthog.com).
# Staff, admin and super-admin panels only; diners' phones never load it. Empty = off.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ─── Platform defaults ──────────────────────────────────────────────────────
# Trial length and payment grace period in days (defaults 14 and 7).
PLATFORM_TRIAL_DAYS=14
PLATFORM_GRACE_DAYS=7
